# copy to .env and edit
VATWORKS_IMAGE=ghcr.io/your-github-user/vatworks:latest
PORT=8090

# Where the web UI listens. Default 127.0.0.1 = this machine only (secure).
# Set to 0.0.0.0 to reach it from other devices on your LAN — and set a
# password below if you do.
HOST=127.0.0.1

# Require a login (HTTP Basic). STRONGLY recommended whenever HOST is not
# 127.0.0.1: without it, anyone on your network can control your printer.
# VATWORKS_USER=admin
# VATWORKS_PASSWORD=change-me
